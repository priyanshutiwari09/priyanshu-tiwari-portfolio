# EmailJS configuration for the contact form.
# Create a free account at https://www.emailjs.com/ and fill these in.
# The contact form falls back to a mailto: link if these are left empty,
# so the site still builds and runs without them.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
